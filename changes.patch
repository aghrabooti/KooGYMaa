+  if (!open) return <button className="trainer-primary-button" onClick={() => setOpen(true)} type="button"><Icon name="plus" size={16} /> New session</button>;
+  return <form className="trainer-session-form" onSubmit={submit}><div className="trainer-session-form__heading"><div><strong>Schedule a session</strong><span>Add a focused coaching block to your calendar.</span></div><button onClick={() => setOpen(false)} type="button">×</button></div>{error && <p className="trainer-form-error">{error}</p>}<div className="trainer-form-grid trainer-form-grid--three"><label><span>Student</span><select defaultValue={selectedClient || ""} name="trainerClientId" required><option value="">Choose student</option>{clients.map((client) => <option key={client.id} value={client.id}>{client.name}</option>)}</select></label><label><span>Session title</span><input defaultValue="Coaching Session" name="title" required /></label><label><span>Gym</span><select name="gymId"><option value="">Private / online</option>{gyms.map((gym) => <option key={gym.id} value={gym.id}>{gym.name}</option>)}</select></label><label><span>Start time</span><input name="startsAt" required type="datetime-local" /></label><label><span>Duration</span><select defaultValue="60" name="duration"><option value="30">30 minutes</option><option value="45">45 minutes</option><option value="60">60 minutes</option><option value="90">90 minutes</option><option value="120">2 hours</option></select></label><label className="trainer-form-wide"><span>Session notes</span><input name="notes" placeholder="Goals, preparation, or location notes" /></label></div><div className="trainer-form-actions"><button className="trainer-secondary-button" onClick={() => setOpen(false)} type="button">Cancel</button><button className="trainer-primary-button" disabled={pending}>{pending ? "Scheduling…" : "Schedule session"}</button></div></form>;
+}
+
+export function SessionActions({ id, status }: { id: string; status: string }) {
+  const [pending, setPending] = useState(""); const router = useRouter();
+  async function update(next: string) { setPending(next); try { const response = await fetch(`/api/trainer/sessions/${id}`, { method: "PATCH", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ status: next }) }); if (response.ok) router.refresh(); } finally { setPending(""); } }
+  return <div className="trainer-session-actions">{status === "SCHEDULED" && <><button className="complete" disabled={Boolean(pending)} onClick={() => update("COMPLETED")}>{pending === "COMPLETED" ? "Saving…" : "Complete"}</button><button disabled={Boolean(pending)} onClick={() => update("NO_SHOW")}>No-show</button><button disabled={Boolean(pending)} onClick={() => update("CANCELLED")}>Cancel</button></>}{status !== "SCHEDULED" && <button disabled={Boolean(pending)} onClick={() => update("SCHEDULED")}>Reschedule</button>}</div>;
+}
+
+export function AvailabilityEditor({ initialSlots, timezone }: { initialSlots: Slot[]; timezone: string }) {
+  const [slots, setSlots] = useState(initialSlots); const [pending, setPending] = useState(false); const [message, setMessage] = useState(""); const [error, setError] = useState(""); const router = useRouter();
+  function patch(index: number, values: Partial<Slot>) { setSlots((current) => current.map((slot, slotIndex) => slotIndex === index ? { ...slot, ...values } : slot)); }
+  async function save() { setPending(true); setError(""); setMessage(""); try { const response = await fetch("/api/trainer/availability", { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ slots, timezone }) }); const data = await response.json(); if (!response.ok) { setError(data.error || "Unable to save availability."); return; } setMessage("Weekly availability saved."); router.refresh(); } catch { setError("Unable to connect."); } finally { setPending(false); } }
+  return <section className="trainer-panel trainer-availability-editor"><div className="trainer-panel__heading"><div><h2>Weekly availability</h2><p>Times are saved in {timezone}.</p></div><button className="trainer-secondary-button" onClick={() => setSlots((current) => [...current, { dayOfWeek: 1, startMinutes: 540, endMinutes: 1020 }])} type="button"><Icon name="plus" size={14} /> Add slot</button></div><div className="trainer-slot-list">{slots.map((slot, index) => <div key={`${index}-${slot.dayOfWeek}`}><select value={slot.dayOfWeek} onChange={(event) => patch(index, { dayOfWeek: Number(event.target.value) })}>{days.map((name, dayIndex) => <option key={name} value={dayIndex}>{name}</option>)}</select><input type="time" value={timeValue(slot.startMinutes)} onChange={(event) => patch(index, { startMinutes: toMinutes(event.target.value) })} /><span>to</span><input type="time" value={timeValue(slot.endMinutes)} onChange={(event) => patch(index, { endMinutes: toMinutes(event.target.value) })} /><button aria-label="Remove slot" onClick={() => setSlots((current) => current.filter((_, slotIndex) => slotIndex !== index))} type="button">×</button></div>)}</div>{!slots.length && <p className="trainer-availability-empty">No weekly slots added. Members won&apos;t see regular availability.</p>}{(message || error) && <p className={error ? "trainer-form-error" : "trainer-form-success"}>{error || message}</p>}<div className="trainer-form-actions"><button className="trainer-primary-button" disabled={pending} onClick={save} type="button">{pending ? "Saving…" : "Save availability"}</button></div></section>;
+}
