+  return <div className="trainer-page"><header className="trainer-page__heading trainer-page__heading--compact"><div><span>CLIENT OUTCOMES</span><h1>Progress tracking</h1><p>Monitor execution, body trends, and coaching conversations.</p></div></header><div className="trainer-progress-grid">{clients.map((client) => { const workoutLogs = client.workoutAssignments[0]?.logs || []; const exercises = workoutLogs.flatMap((log) => log.exerciseLogs); const workoutRate = exercises.length ? Math.round(exercises.filter((item) => item.completed).length / exercises.length * 100) : 0; const nutritionLogs = client.dietAssignments[0]?.logs || []; const meals = nutritionLogs.flatMap((log) => log.mealLogs); const nutritionRate = meals.length ? Math.round(meals.filter((item) => item.completed).length / meals.length * 100) : 0; const latest = client.user.bodyMeasurements[0]; return <Link href={`/trainer/progress/${client.id}`} key={client.id}><div className="trainer-progress-card__top"><span className="trainer-avatar">{client.user.name.slice(0,2).toUpperCase()}</span><b className={`trainer-status trainer-status--${client.status.toLowerCase()}`}>{client.status}</b></div><h2>{client.user.name}</h2><p>{client.user.email}</p><div className="trainer-progress-rings"><span style={{ "--value": `${workoutRate}%` } as CSSProperties}><i>{workoutRate}%</i><small>workouts</small></span><span style={{ "--value": `${nutritionRate}%` } as CSSProperties}><i>{nutritionRate}%</i><small>nutrition</small></span></div><div className="trainer-progress-card__meta"><span><Icon name="trend" size={14} /> {latest?.weightKg ? `${latest.weightKg} kg` : "No measurements"}</span><span>{client.feedback.length} feedback threads</span></div><footer>View progress <Icon name="arrow" size={14} /></footer></Link>; })}</div>{!clients.length && <div className="trainer-panel trainer-empty"><Icon name="trend" size={26} /><strong>No active clients</strong><span>Client progress will appear here.</span></div>}</div>;
