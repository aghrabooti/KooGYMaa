e={food.name} onChange={(event) => patchFood(dayIndex, mealIndex, foodIndex, { name: event.target.value })} placeholder="Food item" /><input disabled={!editable} type="number" value={food.quantity ?? ""} onChange={(event) => patchFood(dayIndex, mealIndex, foodIndex, { quantity: num(event.target.value) })} /><input disabled={!editable} value={food.unit} onChange={(event) => patchFood(dayIndex, mealIndex, foodIndex, { unit: event.target.value })} /><input disabled={!editable} type="number" value={food.calories ?? ""} onChange={(event) => patchFood(dayIndex, mealIndex, foodIndex, { calories: num(event.target.value) })} /><input disabled={!editable} type="number" value={food.protein ?? ""} onChange={(event) => patchFood(dayIndex, mealIndex, foodIndex, { protein: num(event.target.value) })} /><input disabled={!editable} type="number" value={food.carbs ?? ""} onChange={(event) => patchFood(dayIndex, mealIndex, foodIndex, { carbs: num(event.target.value) })} /><input disabled={!editable} type="number" value={food.fat ?? ""} onChange={(event) => patchFood(dayIndex, mealIndex, foodIndex, { fat: num(event.target.value) })} />{editable && <button onClick={() => patchMeal(dayIndex, mealIndex, { foodItems: meal.foodItems.filter((_, i) => i !== foodIndex) })}>×</button>}</div>)}{editable && <button className="trainer-add-row" onClick={() => patchMeal(dayIndex, mealIndex, { foodItems: [...meal.foodItems, blankFood()] })}><Icon name="plus" size={13} /> Add food</button>}</section>)}{editable && <button className="trainer-add-row" onClick={() => patchDay(dayIndex, { meals: [...day.meals, blankMeal()] })}><Icon name="plus" size={14} /> Add meal</button>}</article>)}{editable && <button className="trainer-add-day" onClick={() => setDays((items) => [...items, { key: crypto.randomUUID(), name: `Day ${items.length + 1}`, targetCalories: null, targetProtein: null, targetCarbs: null, targetFat: null, notes: "", meals: [blankMeal()] }])}><Icon name="plus" size={15} /> Add nutrition day</button>}</div>
