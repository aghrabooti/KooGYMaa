+export default async function GymDetailPage({ params }: PageProps) {
+  const user = await requireCurrentUser(["USER"]); const { gymId } = await params;
+  const gym = await prisma.gym.findFirst({
+    where: { id: gymId, status: "ACTIVE" },
+    select: {
+      id: true, name: true, description: true, email: true, phone: true, address: true, city: true, country: true,
+      reviews: { select: { id: true, score: true, comment: true, verified: true, createdAt: true, author: { select: { id: true, name: true } } }, orderBy: { createdAt: "desc" }, take: 12 },
+      subscriptionPlans: { where: { audience: "MEMBER", isActive: true }, select: { id: true, name: true, description: true, price: true, currency: true, durationDays: true }, orderBy: { price: "asc" } },
+      trainers: { where: { status: "ACTIVE", trainer: { isAvailable: true } }, select: { trainer: { select: { id: true, specialty: true, experienceYears: true, hourlyRate: true, currency: true, user: { select: { name: true } }, reviews: { select: { score: true } } } } }, take: 8 },
+      memberships: { where: { userId: user.id }, select: { status: true, requestedAt: true, startedAt: true }, take: 1 },
+      _count: { select: { memberships: { where: { status: "ACTIVE" } }, trainers: { where: { status: "ACTIVE" } } } },
+    },
+  });
+  if (!gym) notFound(); const membership = gym.memberships[0]; const currentReview = gym.reviews.find((review) => review.author.id === user.id); const rating = gym.reviews.length ? gym.reviews.reduce((sum, review) => sum + review.score, 0) / gym.reviews.length : 0;
+  return <div className="member-page"><Link className="member-back" href="/user/gyms"><Icon name="chevron" size={14} /> Back to gyms</Link><section className="market-detail-hero"><div className="market-detail-mark"><Icon name="building" size={38} /></div><div><small>{gym.city || "Location not set"}, {gym.country}</small><h1>{gym.name}</h1><p>{gym.description || "No description has been added yet."}</p><div><span>★ {rating ? rating.toFixed(1) : "New"}</span><span>{gym._count.memberships} members</span><span>{gym._count.trainers} trainers</span></div></div><aside><GymMembershipAction gymId={gym.id} status={membership?.status} />{membership && <span className={`member-status member-status--${membership.status.toLowerCase()}`}>{membership.status}</span>}</aside></section><div className="market-detail-grid"><section className="member-panel"><div className="member-panel__heading"><div><h2>Membership plans</h2><p>Choose the access level that fits you</p></div></div><div className="market-plan-list">{gym.subscriptionPlans.map((plan) => <article key={plan.id}><div><small>{plan.durationDays} DAYS</small><h3>{plan.name}</h3><p>{plan.description || "Gym membership access."}</p></div><strong>{money(plan.price, plan.currency)}</strong><CheckoutButton planId={plan.id} /></article>)}{!gym.subscriptionPlans.length && <p className="member-empty-line">No public member plans yet.</p>}</div></section><section className="member-panel market-contact"><div className="member-panel__heading"><div><h2>Location & contact</h2><p>Get in touch with the gym</p></div></div><div><p><Icon name="location" size={15} /> {gym.address || "Address not set"}</p><p><Icon name="mail" size={15} /> {gym.email || "Email not set"}</p><p><Icon name="user" size={15} /> {gym.phone || "Phone not set"}</p></div></section></div><section className="member-panel market-trainer-strip"><div className="member-panel__heading"><div><h2>Coaching team</h2><p>Available trainers at this gym</p></div><Link href={`/user/trainers?gym=${gym.id}`}>View all <Icon name="arrow" size={13} /></Link></div><div>{gym.trainers.map(({ trainer }) => { const trainerRating = trainer.reviews.length ? trainer.reviews.reduce((sum, review) => sum + review.score, 0) / trainer.reviews.length : 0; return <Link href={`/user/trainers/${trainer.id}`} key={trainer.id}><span>{trainer.user.name.slice(0,2).toUpperCase()}</span><strong>{trainer.user.name}</strong><small>{trainer.specialty || "General fitness"}</small><b>★ {trainerRating ? trainerRating.toFixed(1) : "New"}</b></Link>; })}</div></section><section className="member-panel market-reviews"><div className="member-panel__heading"><div><h2>Member reviews</h2><p>{gym.reviews.length} recent reviews</p></div></div><ReviewEditor type="gym" targetId={gym.id} verified={Boolean(membership?.startedAt)} existing={currentReview ? { score: currentReview.score, comment: currentReview.comment } : undefined} /><div>{gym.reviews.map((review) => <blockquote key={review.id}><header><strong>{review.author.name}</strong><span>{"★".repeat(review.score)}</span><small>{review.createdAt.toLocaleDateString()}</small></header><p>{review.comment || "No written comment."}</p></blockquote>)}</div></section></div>;
