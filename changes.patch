+    } else if (subscriber.trainerProfile) {
+      await transaction.gymTrainer.upsert({
+        where: {
+          gymId_trainerId: {
+            gymId,
+            trainerId: subscriber.trainerProfile.id,
+          },
+        },
+        update: {
+          status: "ACTIVE",
+          reviewedAt: now,
+          reviewedById: authorization.access.user.id,
+          startedAt: now,
+          endedAt: null,
+        },
+        create: {
+          gymId,
+          trainerId: subscriber.trainerProfile.id,
+          status: "ACTIVE",
+          reviewedAt: now,
+          reviewedById: authorization.access.user.id,
+          startedAt: now,
+        },
+      });
+    }
+
+    return created;
+  });
+
+  return NextResponse.json({ subscription }, { status: 201 });
+}
