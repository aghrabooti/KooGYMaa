+export default async function MemberSchedulePage(){const user=await requireCurrentUser(["USER"]);const now=new Date();const sessions=await prisma.trainingSession.findMany({where:{trainerClient:{userId:user.id}},select:{id:true,title:true,startsAt:true,endsAt:true,status:true,notes:true,trainer:{select:{id:true,user:{select:{name:true}}}},gym:{select:{name:true}}},orderBy:{startsAt:"asc"},take:100});const upcoming=sessions.filter(item=>item.startsAt>=now&&item.status==="SCHEDULED");const history=sessions.filter(item=>item.startsAt<now||item.status!=="SCHEDULED").reverse();return <div className="member-page"><header className="member-page__heading"><div><span>COACHING</span><h1>Your schedule</h1><p>Upcoming sessions and coaching history.</p></div></header><section className="member-panel member-schedule"><div className="member-panel__heading"><div><h2>Upcoming sessions</h2><p>{upcoming.length} scheduled</p></div></div>{upcoming.length?<div>{upcoming.map(session=><article key={session.id}><div><strong>{time(session.startsAt)}</strong><small>{day(session.startsAt)}</small></div><span/><div><h3>{session.title}</h3><p><Link href={`/user/trainers/${session.trainer.id}`}>{session.trainer.user.name}</Link> · {session.gym?.name||"Private / online"} · {Math.round((session.endsAt.getTime()-session.startsAt.getTime())/60000)} min</p>{session.notes&&<small>{session.notes}</small>}</div><b className="member-status member-status--scheduled">SCHEDULED</b></article>)}</div>:<div className="member-empty"><Icon name="calendar" size={25}/><h2>No upcoming sessions</h2><p>Request coaching or ask your trainer to schedule a session.</p></div>}</section><section className="member-panel member-history"><div className="member-panel__heading"><div><h2>Session history</h2><p>{history.length} previous sessions</p></div></div>{history.length?<div>{history.map(session=><article key={session.id}><span className={`member-status member-status--${session.status.toLowerCase()}`}>{session.status}</span><div><strong>{session.title}</strong><small>{session.trainer.user.name} · {day(session.startsAt)} at {time(session.startsAt)}</small></div><b>{session.gym?.name||"Private"}</b></article>)}</div>:<p className="member-empty-line">No session history yet.</p>}</section></div>}
