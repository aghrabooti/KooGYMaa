+type PageProps = { searchParams: Promise<{ log?: string }> };
+export default async function UserNutritionPage({ searchParams }: PageProps) {
+  const user = await requireCurrentUser(["USER"]); const { log: logId } = await searchParams;
+  if (logId) {
+    const log = await prisma.nutritionLog.findFirst({ where: { id: logId, userId: user.id }, select: { id: true, dietDay: { select: { name: true, plan: { select: { title: true } } } }, mealLogs: { orderBy: { meal: { order: "asc" } }, select: { mealId: true, completed: true, actualPortion: true, substitution: true, meal: { select: { name: true, scheduledTime: true, foodItems: { orderBy: { order: "asc" }, select: { name: true } } } } } } } });
+    if (!log) notFound();
+    return <div className="member-page"><NutritionLogForm logId={log.id} title={`${log.dietDay.plan.title} · ${log.dietDay.name}`} initial={log.mealLogs.map((item) => ({ mealId: item.mealId, name: item.meal.name, scheduledTime: item.meal.scheduledTime, completed: item.completed, actualPortion: item.actualPortion || "", substitution: item.substitution || "", foods: item.meal.foodItems.map((food) => food.name) }))} /></div>;
+  }
+  const [assignment, recent] = await Promise.all([
+    prisma.dietAssignment.findFirst({ where: { userId: user.id, status: "ACTIVE" }, select: { id: true, plan: { select: { title: true, version: true, description: true, dailyCalories: true, dietaryRestrictions: true, trainer: { select: { user: { select: { name: true } } } }, days: { orderBy: { dayNumber: "asc" }, select: { id: true, dayNumber: true, name: true, targetCalories: true, targetProtein: true, targetCarbs: true, targetFat: true, meals: { select: { id: true, name: true, scheduledTime: true, foodItems: { select: { name: true } } } } } } } } }, orderBy: { assignedAt: "desc" } }),
+    prisma.nutritionLog.findMany({ where: { userId: user.id }, select: { id: true, logDate: true, completedAt: true, hungerRating: true, energyRating: true, dietDay: { select: { name: true, plan: { select: { title: true } } } }, mealLogs: { select: { completed: true } } }, orderBy: { logDate: "desc" }, take: 10 }),
+  ]);
+  return <div className="member-page"><header className="member-page__heading"><div><span>NUTRITION</span><h1>Your daily nutrition</h1><p>Keep meals practical, track consistency, and share context with your coach.</p></div></header>{assignment ? <><section className="member-plan-hero member-plan-hero--nutrition"><span><Icon name="heart" size={25} /></span><div><small>ACTIVE PLAN · VERSION {assignment.plan.version}</small><h2>{assignment.plan.title}</h2><p>Coach {assignment.plan.trainer.user.name}{assignment.plan.dietaryRestrictions ? ` · ${assignment.plan.dietaryRestrictions}` : ""}</p></div><div><strong>{assignment.plan.dailyCalories || "—"}</strong><span>kcal target</span></div></section><div className="member-nutrition-grid">{assignment.plan.days.map((day) => <article key={day.id}><header><span>{day.dayNumber}</span><div><h2>{day.name}</h2><p>{day.targetCalories || assignment.plan.dailyCalories || "Flexible"} kcal · P {day.targetProtein || "—"} / C {day.targetCarbs || "—"} / F {day.targetFat || "—"}</p></div></header><div>{day.meals.map((meal) => <section key={meal.id}><span>{meal.scheduledTime || "Anytime"}</span><div><strong>{meal.name}</strong><small>{meal.foodItems.map((food) => food.name).join(", ")}</small></div></section>)}</div><StartNutritionLog assignmentId={assignment.id} dayId={day.id} /></article>)}</div></> : <div className="member-panel member-empty"><Icon name="heart" size={27} /><h2>No active nutrition plan</h2><p>Your trainer hasn&apos;t assigned a nutrition plan yet.</p></div>}<section className="member-panel member-history"><div className="member-panel__heading"><div><h2>Nutrition history</h2><p>Recent daily compliance</p></div></div>{recent.length ? <div>{recent.map((item) => { const complete = item.mealLogs.filter((meal) => meal.completed).length; return <article key={item.id}><span className={`member-status ${item.completedAt ? "member-status--completed" : "member-status--in_progress"}`}>{item.completedAt ? "COMPLETED" : "IN PROGRESS"}</span><div><strong>{item.dietDay.name}</strong><small>{item.dietDay.plan.title} · {item.logDate.toLocaleDateString()}</small></div><b>{complete}/{item.mealLogs.length} meals</b><small>Energy {item.energyRating || "—"}/10</small></article>; })}</div> : <p className="member-empty-line">Your nutrition logs will appear here.</p>}</section></div>;
