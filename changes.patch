+  function patchFood(dayIndex: number, mealIndex: number, foodIndex: number, values: Partial<Food>) { setDays((items) => items.map((day, i) => i === dayIndex ? { ...day, meals: day.meals.map((meal, j) => j === mealIndex ? { ...meal, foodItems: meal.foodItems.map((food, k) => k === foodIndex ? { ...food, ...values } : food) } : meal) } : day)); }
+  const payload = () => ({ ...meta, days: days.map((day) => ({ name: day.name, notes: day.notes, targetCalories: day.targetCalories, targetProtein: day.targetProtein, targetCarbs: day.targetCarbs, targetFat: day.targetFat, meals: day.meals.map((meal) => ({ name: meal.name, scheduledTime: meal.scheduledTime, notes: meal.notes, foodItems: meal.foodItems.map((food) => ({ name: food.name, quantity: food.quantity, unit: food.unit, calories: food.calories, protein: food.protein, carbs: food.carbs, fat: food.fat, notes: food.notes })) })) })) });
+  async function save() { setPending("save"); setError(""); setMessage(""); try { const response = await fetch(`/api/trainer/nutrition/${plan.id}`, { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload()) }); const data = await response.json(); if (!response.ok) { setError(data.error || "Unable to save plan."); return false; } setMessage("Nutrition plan saved."); router.refresh(); return true; } catch { setError("Unable to connect."); return false; } finally { setPending(""); } }
+  async function publish() { if (editable && !(await save())) return; setPending("publish"); try { const response = await fetch(`/api/trainer/nutrition/${plan.id}`, { method: "PATCH", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ status: "ACTIVE" }) }); const data = await response.json(); if (!response.ok) { setError(data.error || "Unable to publish plan."); return; } router.refresh(); } finally { setPending(""); } }
