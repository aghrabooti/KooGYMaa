# Local SQLite database for development.
DATABASE_URL=file:./dev.db

# Hosted libSQL database (e.g. Turso) — required in production. When set,
# LIBSQL_DATABASE_URL takes priority over DATABASE_URL, so stale DATABASE_URL
# values on the host can never shadow the live database.
LIBSQL_DATABASE_URL=
LIBSQL_DATABASE_AUTH_TOKEN=

# Required in production. Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional development seed password. Never use this value in production.
SEED_PASSWORD=KooGYMaa123!

# Payment provider. `demo` is safe for local development only.
PAYMENT_PROVIDER=demo
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-webhook-secret-at-least-32-characters
APP_URL=http://localhost:3000
# Set true only if you intentionally deploy the demo provider.
ALLOW_DEMO_PAYMENTS=false
