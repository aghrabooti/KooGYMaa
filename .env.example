# Local SQLite database. Replace with a hosted libSQL URL when deploying.
DATABASE_URL=file:./dev.db
# Auth token for hosted libSQL (e.g. Turso). Not needed for local file:./dev.db.
LIBSQL_DATABASE_AUTH_TOKEN=

# Required in production. Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional development seed password. Never use this value in production.
SEED_PASSWORD=KooGYMaa123!

# Payment provider. `demo` is safe for local development only.
PAYMENT_PROVIDER=demo
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-webhook-secret-at-least-32-characters
APP_URL=http://localhost:3000
# Set true only if you intentionally deploy the demo provider.
ALLOW_DEMO_PAYMENTS=false
